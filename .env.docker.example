# The single Docker environment file for the self-hosted Custotal stack.
#
#   cp .env.docker.example .env.docker
#   pnpm docker:up
#
# This is the ONLY environment file the Docker stack reads. It carries both the
# values Compose substitutes into docker-compose.yml (database credentials, published
# ports, public origin, image tag, registry) and the application settings the API
# container receives (SMTP, tenant locale, backup retention, purge schedule).
# It replaces the former split between this file and `packages/backend/.env.docker`.
#
# Never commit the real `.env.docker` — it is gitignored.
#
# Precedence for the API container, lowest to highest:
#
#   1. built-in defaults        packages/backend/src/config.ts
#   2. this file                injected through the `backend` service's env_file
#   3. Compose `environment`    docker-compose.yml / docker-compose.dev.yml — NODE_ENV, PORT,
#                               DATABASE_URL, TRUST_PROXY, INSTANCE_ENVIRONMENT
#
# Compose reads this file twice: for `$…` substitution in docker-compose.yml and as the
# `backend` service's env_file. Because both come from one place, the values the
# container sees can no longer drift from the ones Compose substitutes.
#
# The root `package.json` `docker:*` scripts (`pnpm docker:up`, `pnpm docker:logs`,
# `pnpm docker:migrate`, …) pass `--env-file .env.docker` for you, so the flag is
# never typed by hand. A raw `docker compose` command still needs it, since
# Compose only auto-loads a file named `.env`; alternatively export
# `COMPOSE_ENV_FILES=.env.docker` for the shell session.
#
# The full annotated list of backend settings (including the keys Compose owns)
# is in `packages/backend/.env.example`.

# ---- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=custotal
# Required. Change before the first start.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=custotal

# ---- Public origin -----------------------------------------------------------
# Set both to the origin users actually reach (https://crm.example.com) when
# deploying behind TLS. APP_PUBLIC_URL is used for invite/reset links, and
# CORS_ORIGINS plus the CSRF origin check rely on the exact value.
APP_PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
# Hostname surfaced on the sign-in screen and by GET /api/health.
INSTANCE_HOSTNAME=localhost
# Must be true behind HTTPS (session cookies are then marked Secure).
COOKIE_SECURE=false

# ---- Images ------------------------------------------------------------------
# `local` builds the images in this repository. Set a released version (or
# `latest`) to pull prebuilt images from the GitHub Container Registry instead.
CUSTOTAL_TAG=local
# Owner-prefixed registry path the release pipeline publishes to. Required for a
# released `CUSTOTAL_TAG` to resolve to a published image; leave unset to build.
# CUSTOTAL_REGISTRY=ghcr.io/orbivort/

# ---- Package registry --------------------------------------------------------
# Registry used to download npm/pnpm packages while building the images. Leave
# unset to use the official registry (https://registry.npmjs.org/); set a mirror
# when npmjs.org is slow or unreachable.
# NPM_REGISTRY=your-mirror-registry

# ---- Published ports ---------------------------------------------------------
# Used by docker-compose.yml / docker-compose.dev.yml. The public entry point is the web
# container; the API and database ports are only published by docker-compose.dev.yml.
CUSTOTAL_HTTP_PORT=8080
CUSTOTAL_API_PORT=4000
POSTGRES_PORT=5432

# ---- Email / SMTP ------------------------------------------------------------
# Without SMTP_HOST the mailer logs invite/reset links instead of sending them,
# which is not a working deployment. Use a relay reachable from the container
# network — `localhost` here means the API container itself.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Custotal <no-reply@example.com>
# Log message bodies instead of sending them (staging smoke tests). Defaults to
# true under NODE_ENV=test.
# SMTP_TEST_MODE=

# ---- Tenant / locale ---------------------------------------------------------
# IANA timezone used for date-only semantics and "overdue" computation.
TENANT_TIMEZONE=UTC
# Organization name surfaced on the sign-in screen and by GET /api/health.
INSTANCE_ORG_NAME=Custotal
# Offer the password-reset flow on the sign-in screen.
INSTANCE_ALLOW_PASSWORD_RESET=true
# First-run setup banner. There is no setup flow, so leave this false.
# INSTANCE_SETUP_REQUIRED=false
# Set by Compose (`production`; docker-compose.dev.yml uses `development`).
# INSTANCE_ENVIRONMENT=production

# ---- Sessions & credentials --------------------------------------------------
SESSION_TTL_HOURS=8
# Keep `lax`: the CSRF origin check depends on it (and on CORS_ORIGINS).
COOKIE_SAMESITE=lax
RESET_TOKEN_TTL_MINUTES=60
TEMP_PASSWORD_TTL_DAYS=7

# ---- Backups & maintenance ---------------------------------------------------
# Inside the container this path is the `backups` volume mounted by docker-compose.yml.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
# In-process daily soft-delete purge, at server-local time. Set this to false
# when an external scheduler owns the purge and run `pnpm purge` on a timer.
MAINTENANCE_PURGE_ENABLED=true
MAINTENANCE_PURGE_HOUR=2
MAINTENANCE_PURGE_MINUTE=0

# ---- Container behaviour -----------------------------------------------------
# Apply pending migrations from the API container's entrypoint instead of the
# one-shot `migrate` service. Leave false to keep start-up deterministic.
# Requires the `tools` image — the API image ships no Prisma CLI (docs/self-hosting.md#migrations).
# RUN_MIGRATIONS=false
