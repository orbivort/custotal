# Custotal backend environment configuration.
# Copy to `.env` and adjust. Never commit real `.env` files.

# ---- App -----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---- Database -------------------------------------------------------------
# Single Postgres connection string. Keep query params out unless you know why.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/custotal_dev

# Used by the integration test harness to prepare/migrate a throwaway schema.
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/custotal_test

# ---- Sessions & security --------------------------------------------------
# Idle session lifetime in hours (FR-CC-01: 8h idle timeout).
SESSION_TTL_HOURS=8
# Mark the session cookie Secure. Must be false for plain-HTTP local dev,
# true when served over HTTPS.
COOKIE_SECURE=false
# Cookie is HttpOnly + SameSite=Lax always; SameSite value can be overridden here.
COOKIE_SAMESITE=lax
# Comma-separated list of allowed browser origins (CORS) for cross-origin dev.
CORS_ORIGINS=http://localhost:5173

# ---- Email / SMTP -----------------------------------------------------------
# Used by the mailer for invitation and password-reset messages.
# When SMTP_HOST is left empty, the mailer degrades gracefully: no email is
# sent and the invite/reset link is written to the application log instead,
# so local development works without a mail server.
SMTP_HOST=
# SMTP port. Typical values: 587 (STARTTLS), 465 (implicit TLS), 25 (plain).
SMTP_PORT=587
# Use a direct TLS connection (implicit TLS). true for port 465, false for 587.
SMTP_SECURE=false
# SMTP authentication credentials. Leave user empty to send without auth
# (e.g. a local relay like MailHog or Postfix on localhost).
SMTP_USER=
SMTP_PASS=
# From address shown on outgoing emails. Must be a valid RFC 5322 address.
SMTP_FROM=Custotal <no-reply@custotal.local>
# Test mode: never open a real SMTP connection, always log the message body
# instead. Defaults to true when NODE_ENV=test, so a stray SMTP_HOST can never
# cause real email sends during test runs. Set to true to force the log-only
# fallback in any environment (e.g. staging smoke tests).
SMTP_TEST_MODE=

# ---- Password reset / invitations ------------------------------------------
# Public origin of the frontend, used to build invite/reset links in emails.
APP_PUBLIC_URL=http://localhost:5173
# Time a reset/invite token stays valid, in minutes.
RESET_TOKEN_TTL_MINUTES=60
# How long a temporary credential (issued when an invite email could not be
# delivered) remains valid before login rejects it and forces a reset.
TEMP_PASSWORD_TTL_DAYS=7

# ---- Tenant / locale ------------------------------------------------------
# Single-tenant MVP. Timezone used for date-only semantics and "overdue"
# computation (FR-CC-14). Format: IANA name (e.g. America/New_York) or UTC.
TENANT_TIMEZONE=UTC
# Instance identity surfaced by GET /api/health for the login screen.
INSTANCE_ORG_NAME=Custotal
INSTANCE_ENVIRONMENT=development
INSTANCE_HOSTNAME=localhost
# Offer the password-reset flow on the sign-in screen. Set to false when no mail
# transport is wired up yet.
INSTANCE_ALLOW_PASSWORD_RESET=true
# First-run setup banner surfaced by GET /api/health. No seed or setup flow
# exists, so this stays false unless an operator overrides it.
INSTANCE_SETUP_REQUIRED=false

# ---- Backups --------------------------------------------------------------
# Daily pg_dump destination and retention window in days (FR-CC-04).
# The backup is a separate process (run it from the OS scheduler) so it keeps
# running even when the application is down.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# ---- Maintenance ----------------------------------------------------------
# The backend purges soft-deleted records older than 30 days (FR-CC-05) from an
# in-process daily timer armed once the server is listening. It runs once a day
# at MAINTENANCE_PURGE_HOUR:MAINTENANCE_PURGE_MINUTE, server-local (default
# 02:00). Hour is clamped to 0-23 and minute to 0-59.
MAINTENANCE_PURGE_ENABLED=true
MAINTENANCE_PURGE_HOUR=2
MAINTENANCE_PURGE_MINUTE=0
