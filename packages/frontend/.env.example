# Custotal frontend environment configuration.
# Copy to `.env.local` (development only) or configure in CI/deployments.
# Only variables prefixed with VITE_ are exposed to client code.

# ---- Data source toggle ------------------------------------------------------
# When unset or false, the app calls the real backend (default). When set to
# "true", Mock Service Worker intercepts /api/* in development only and serves
# the seeded mock data (see src/mocks). MSW is never active outside the Vite
# dev server regardless of this flag: the standalone demo site published to
# GitHub Pages is produced by `pnpm build:demo` (`vite build --mode demo`), where
# the mode — not this flag — is what enables the mocks.
VITE_ENABLE_MOCKS=true

# ---- Backend base URL ---------------------------------------------------------
# Absolute base URL of the backend. Leave empty (recommended) to call the same
# origin: the Vite dev server proxies /api to the backend (see vite.config.ts),
# and production builds are expected to serve the SPA and API from one origin.
# Only set this when the API lives on a different origin than the SPA; the HTTP
# client then sends cookies with credentials:'include', which requires the
# backend CORS allow-list to include this origin.
# VITE_API_BASE_URL=http://localhost:4000

# Optional: overrides where the Vite dev server forwards /api (defaults to
# http://localhost:4000). Rarely needed.
# VITE_API_PROXY_TARGET=http://localhost:4000

# ---- Deployment sub-path --------------------------------------------------------
# Sub-path the built bundle is served from. Set it to "/<repo>" for a GitHub
# Pages project site — the Pages workflow does this automatically from the
# base_path reported by actions/configure-pages. Leave it unset for a root
# deployment, a user/org site, or a custom domain. Build-time only.
# VITE_BASE_PATH=/custotal

# ---- Default currency ------------------------------------------------------------
# ISO 4217 currency code used app-wide as the default currency. It drives the
# "Value (XXX)" form label, the "(XXX)" suffixes in CSV export headers, the
# currency symbol rendered by formatCurrency(), and the currency persisted with
# newly created deals — so the label and the stored data always match. Must be
# exactly three letters (e.g. USD, EUR, GBP); unset or malformed falls back to
# USD. Note: Vite bakes VITE_ variables in at build time, so changing this
# requires a rebuild.
# VITE_DEFAULT_CURRENCY=USD
