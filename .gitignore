# ---- Dependencies ----------------------------------------------------------
node_modules/

# ---- Build output ----------------------------------------------------------
dist/
.vite/
*.tsbuildinfo

# ---- Test coverage ---------------------------------------------------------
coverage/

# Playwright
playwright-report/
test-results/
# Persisted authenticated storage states, regenerated by e2e/setup/auth.setup.ts
**/e2e/.auth/

# ---- Local environment files (never commit real secrets) -------------------
.env
.env.*
!.env.example
!.env.production.example
!.env.docker.example
*.local

# ---- Internal workspace (PRDs, reviews, generated handoff files) ------------
temp/

# ---- Version-control metadata (SVN working copies must not ship) -----------
.svn/

# ---- Editor / IDE / assistant state ----------------------------------------
.vscode/
.idea/
.cursor/
.cursorrules
*.copilot
.codebuddy/
AGENTS.md
CODEBUDDY.md
openspec/
.agents
.claude
.windsurf
skills-lock.json

# ---- Backups and database dumps --------------------------------------------
backups/
*.dump

# ---- Logs ------------------------------------------------------------------
*.log
*.log.*

# ---- Tool caches -----------------------------------------------------------
# Written when ESLint / Stylelint run with --cache; disposable.
.eslintcache
.stylelintcache

# ---- OS metadata -----------------------------------------------------------
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Database & ORM
# -----------------------------------------------------------------------------
# Prisma generated client (generator output = ../src/generated/prisma). The whole
# src/generated tree is ignored so git, ESLint, Prettier and Docker agree on the
# scope; nothing hand-written belongs there.
**/src/generated/
**/prisma/generated/

# NOTE: prisma/migrations/migration_lock.toml is intentionally NOT ignored.
# Prisma keeps it in the migration history (it detects datasource provider
# changes), and the file itself states it must be added to version control.
