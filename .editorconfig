# EditorConfig — https://editorconfig.org
# Complements Prettier (.prettierrc.json) and keeps editors consistent across the team.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing whitespace is meaningful in Markdown (hard line breaks).
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{ps1,bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
